# OpenAI (for LLM + embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Vapi
VAPI_PUBLIC_KEY=your_vapi_public_key
VAPI_PRIVATE_KEY=your_vapi_private_key

# Cal.com
CAL_API_KEY=your_cal_api_key_here
CAL_EVENT_TYPE_ID=your_event_type_id

# PostgreSQL (Railway provides this automatically as DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (for ingestion queue)
REDIS_URL=redis://localhost:6379/0

# Auth (JWT signing secret — generate a long random string)
JWT_SECRET=your_jwt_secret_here

# Backblaze B2 (S3-compatible file storage)
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_ACCESS_KEY=your_b2_key_id
B2_SECRET_KEY=your_b2_application_key
B2_BUCKET=tenants

# CORS allowed origins (comma-separated). Use specific origins in prod.
CORS_ORIGINS=*

# Elastic Email (transactional email API — required since Railway blocks outbound SMTP)
ELASTIC_EMAIL_KEY=your_elastic_email_api_key
MAIL_FROM=nik68199@gmail.com
ADMIN_NOTIFY_EMAIL=nik68199@gmail.com

# Public domain (used in email CTA links)
RAILWAY_PUBLIC_DOMAIN=https://your-app.up.railway.app
