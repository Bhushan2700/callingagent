# OpenAI (for LLM + embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Groq (fastest LLM, free tier — use for speed)
GROQ_API_KEY=your_groq_api_key_here

# Switch LLM provider: "groq" (fastest/free) or "openai" (best quality)
LLM_PROVIDER=groq

# Vapi
VAPI_PUBLIC_KEY=your_vapi_public_key
VAPI_PRIVATE_KEY=your_vapi_private_key
VAPI_ASSISTANT_ID=your_vapi_assistant_id
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id

# Cal.com
CAL_API_KEY=your_cal_api_key_here
CAL_EVENT_TYPE_ID=your_event_type_id

# PostgreSQL (Railway provides this automatically as DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (for ingestion queue)
REDIS_URL=redis://localhost:6379/0
